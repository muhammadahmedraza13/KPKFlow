@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login | Eazy Flow</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/image/favicon.png" type="image/x-icon">
    <link href="~/Public/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    @* <link href="~/Public/css/custom-css/Layout/style.css" rel="stylesheet" type="text/css" />
    <link href="~/Public/css/custom-css/Layout/responsive.css" rel="stylesheet" type="text/css" />
    <link href="~/Public/vendor/boxicons/css/boxicons.min.css" rel="stylesheet" type="text/css" /> *@
    <link href="~/Public/css/vendors.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Public/css/theme.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Public/vendor/fontawesome/css/all.min.css" rel="stylesheet" />
    <link href="~/Public/css/custom-css/Layout/style.css" rel="stylesheet" />
</head>

<body class="login-body">
     <main class="auth-cover-wrapper">
        <div class="auth-cover-content-inner">
            <div class="auth-cover-content-wrapper">
                <div class="auth-cover-sidebar-inner">
                    <div class="auth-cover-card-wrapper">
                        <div class="auth-cover-card p-sm-5">
                            <div class="mb-5">
                                <img src="~/Public/image/logo.png" alt="Logo" class="img-fluid">
                            </div>
                            <h2 class="fs-20 fw-bolder mb-4 text-white">Please login to your account</h2>
                            <form id="restpasswordform" name="restpasswordform" method="post" action="@Url.Action("ForgetPassword", "Login")" class="w-100 mt-4 pt-2">
                                <div class="mb-4">
                                    <input type="email" class="form-control" id="UserEmail" name="UserEmail" placeholder="Enter Your Email" required>
                                </div>
                                <div class="mb-3">
                                    <span class="mt-2 redcolor">@ViewBag.Message</span>
                                </div>
                                <div class="mt-5">
                                    <button type="submit" class="btn btn-primary savebutton w-100"><i class="fa-solid fa-floppy-disk pe-2"></i>Send</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
    </main>

    <script src="~/Public/vendor/jquery/jquery-3.7.1.min.js"></script>
    <script src="~/Public/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Public/vendor/jquery/jquery.validate.min.js"></script>
    <script src="~/Public/js/class/APICALL.js"></script>
</body>
</html>