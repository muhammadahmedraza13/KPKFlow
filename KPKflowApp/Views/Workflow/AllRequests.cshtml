@inject KPKflowApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "All Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3>All Requests</h3>
            </div>
            <div class="card-body">
                <div id="workflowDiv">
                    <div class="div-loader">
                        <div class="loader-wrapper d-none">
                            <span class="loader"></span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered" id="myTask">
                                <thead>
                                    <tr>
                                        <th>Request Id</th>
                                        <th>Current Step</th>
                                        <th>Last Updated By</th>
                                        <th>Last Updated On</th>
                                        <th>Created By</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section BottomJS {
    <script src="~/Public/js/custom-js/Workflow/WorkflowManager.js"></script>
    <script src="~/public/js/custom-js/workflow/allrequests.js"></script>
}