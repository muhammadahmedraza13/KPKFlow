@inject KPKflowApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Invite Vendor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss
{
    <link href="~/public/css/custom-css/settings/invitevendor.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
}

@{

    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();
    KPKflowApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);
    List<KPKflowApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;
    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
    string wfCode = ViewBag.wfCode;
    string defaultform = sessionItems.userInfo.DefaultFormName;
}

<div class="row mb-4">
    <div class="col-12">
        <div class="page-header-left d-flex flex-column gap-1">
            <nav aria-label="breadcrumb">
                <ul class="breadcrumb mb-2" style="background: transparent; padding: 0;">
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">Bank Management</a></li>
                    <li class="breadcrumb-item active fw-bold text-primary">Invitations</li>
                </ul>
            </nav>
            <div class="page-header-title">
                <h3 class="fw-bold m-0 text-dark">Bank Invitation</h3>
                <p class="text-muted small">Send secure onboarding links to your partners. They will be guided to complete their corporate profile and compliance documents.</p>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom-0 d-flex align-items-center justify-content-start gap-2">
                <div class="icon-shape bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; flex-shrink: 0;">
                    <i class="fa-solid fa-paper-plane"></i>
                </div>
                <h5 class="card-title mb-0 fw-bold ms-1">Invite New Banks</h5>
            </div>
            <div class="card-body pt-0">
                <form id="inviteVendorform" autocomplete="off">
                    <input type="hidden" name="BuyerId" value="@UserID?.ToString()" />

                    <div class="row align-items-center g-3">
                        <div class="col-lg-6">
                            <label class="form-label fw-semibold small text-uppercase text-muted">Official Email Addresses</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                                <input type="email" id="email-input" class="form-control border-start-0 ps-2" placeholder="example@company.com">
                                <button type="button" id="addEmailBtn" class="btn btn-outline-primary fw-bold">
                                    <i class="fa-solid fa-plus me-1"></i> Add
                                </button>
                            </div>
                            <div id="email-tags-container" class="d-flex flex-wrap gap-2 mt-2">
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <label class=""></label>
                            <button id="sendInvitation" type="button" class="btn btn-primary w-90 fw-bold shadow-sm py-3">
                                Send Invitations <i class="fa-solid fa-paper-plane ms-2"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-4 px-4 border-0 d-flex justify-content-between align-items-center">
                    <div>
                    <h4 class="fw-bold mb-1 text-dark">Registered Bank Application</h4>
                        <p class="text-muted small mb-0">List of all registered business accounts</p>
                    </div>
                    <div class="search-container">
                        <input type="text" id="tableSearch" class="form-control form-control-solid border-0 bg-light rounded-3" placeholder="Search data..." style="width: 280px;">
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="table-responsive">
                        <table id="Vendor-master" class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Bank</th>
                                    <th>Username</th>
                                    <th>Email Address</th>
                                    <th>Login Name</th>
                                    <th>Mobile</th>
                                    <th>City</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Details</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>


        <div class="modal fade" id="vendorDetailsModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="d-flex align-items-center">
                            <div class="p-3 rounded-4 me-3 d-none d-sm-flex align-items-center justify-content-center"
                                 style="background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); width: 56px; height: 56px;">
                                <i class="fas fa-building text-white fs-4"></i>
                            </div>
                            <div>
                                <h5 class="modal-title mb-1">Business Registration Details</h5>
                                <p class="text-white-50 mb-0 small fw-light">Verified Bank Profile & Compliance Data</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-4 p-md-5" id="detailsContent">
                        <div class="section-title-wrapper mt-0">
                            <div class="section-divider-bar"></div>
                            <span class="section-title">General Information</span>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="info-box">
                                    <span class="info-label">Company Name</span>
                                    <div class="info-data">Enterprise Solutions PVT LTD</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-box">
                                    <span class="info-label">NTN / Registration No.</span>
                                    <div class="info-data">1234567-8</div>
                                </div>
                            </div>
                        </div>

                        <div class="section-title-wrapper">
                            <div class="section-divider-bar"></div>
                            <span class="section-title">Compliance Documents</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <a href="#" class="attachment-card">
                                    <div class="attachment-icon-wrapper">
                                        <i class="fas fa-file-pdf"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small">NTN Certificate</div>
                                        <div class="text-muted" style="font-size: 11px;">View Document</div>
                                    </div>
                                </a>
                            </div>
                            <div class="col-sm-6">
                                <a href="#" class="attachment-card">
                                    <div class="attachment-icon-wrapper">
                                        <i class="fas fa-file-invoice"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small">STRN Certificate</div>
                                        <div class="text-muted" style="font-size: 11px;">View Document</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section BottomJS {
    <script src="~/public/js/custom-js/settings/inviteVendor.js"></script>
}