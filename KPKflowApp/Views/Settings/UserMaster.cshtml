@inject KPKflowApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "User Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss {
    @* <link href="~/Public/css/custom-css/Settings/UserMaster.css" rel="stylesheet" /> *@
}

@{

    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();

    KPKflowApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);

    List<KPKflowApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;

    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
}

<div class="row">
    <div class="col-12">
        <div class="card stretch stretch-full">
            <div class="card-header">
                <h5 class="card-title">User Management</h5>
                <button class="btn btn-primary" id="AdUserBtn" type="button"><i class='feather-user me-2'></i>Fetch Ad Users</button>
            </div>
            <div class="card-body">
                <form id="usermasterform" name="usermasterform" method="post" action="" autocomplete="off">
                    <div class="row" id="Form1">
                        <div class="d-none col-12 col-sm-12 col-md-12 col-lg-3">
                            <input type="text" class="form-control" id="EditUserID" name="EditUserID" value="">
                        </div>
                        <div class="d-none col-12 col-sm-12 col-md-12 col-lg-3">
                            <input type="text" class="form-control" id="UserID" name="UserID" value="">
                        </div>
                        <div class="d-none col-12 col-sm-12 col-md-12 col-lg-3">
                            <input type="text" class="form-control" id="StatusID" name="StatusID" value="">
                        </div>
                        <div class="d-none col-12 col-sm-12 col-md-12 col-lg-3">
                            <input type="text" class="form-control" id="DomainName" name="DomainName" value="">
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3">
                            <label>User Name</label>
                            <input type="text" class="form-control" id="UserName" name="UserName" autocomplete="off" required>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3 mt-3 mt-lg-0">
                            <label>Login Name</label>
                            <input type="text" class="form-control" id="LoginName" name="LoginName" autocomplete="off" required>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3 mt-3 mt-lg-0">
                            <label>User Email</label>
                            <input type="email" class="form-control" id="UserEmail" name="UserEmail" autocomplete="off">
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3 mt-3 mt-lg-0">
                            <label>Designation</label>
                            <input type="text" class="form-control" id="Designation" name="Designation" autocomplete="off">
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3 mt-3">
                            <label>Department</label>
                            <input type="text" class="form-control" id="Department" name="Department" autocomplete="off">
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3 mt-3">
                            <label>Contact Number</label>
                            <input type="text" class="form-control" id="MobileNumber" name="MobileNumber" autocomplete="off" required>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3 mt-3">
                            <label>User Type</label>
                            <select class="form-select" name="UserTypeID" id="UserTypeID" required>
                                <option value="">Select User Type</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3 mt-3">
                            <label>Role Name</label>
                            <select class="rolename form-select" name="RoleID" id="RoleID" required>
                                <option value="">Select Role</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3 mt-3">
                            <label>Form Name</label>
                            <select class="formname form-select" name="FormID" id="FormID" required>
                                <option value="">Select Default Form</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-12 col-md-3 col-lg-3 mt-3 mt-lg-auto">
                            <input type="checkbox" id="IsActive" name="IsActive">
                            <label>Active</label>
                        </div>
                        <div class="col-12 col-sm-12 col-md-3 col-lg-3 mt-3 mt-lg-auto d-none">
                            <input type="checkbox" id="IsAdUser" name="IsAdUser">
                            <label>Is AD User?</label>
                        </div>
                    </div>

                    <div class="row mt-3">

                        <div class="col-12 d-flex justify-content-end">
                            @if (_allowinsert)
                            {
                                <button class="btn btn-primary btn-sm savebutton" id="SaveBtn" type="button"><i class='feather-save me-2'></i>Save</button>

                            }
                            @if (_allowupdate)
                            {
                                <button class="btn btn-primary btn-sm d-none  updatebutton" id="UpdateBtn" type="button"><i class='feather-save me-2'></i>Update</button>

                            }
                            <button class="btn btn-danger btn-sm ms-2 clearbutton" id="ClearBtn" type="button"><i class='feather-x me-2'></i>Clear</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body p-0">
                <div id="UserMasterDiv">
                    <div class="div-loader">
                        <div class="loader-wrapper d-none">
                            <span class="loader"></span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover" id="user-master">
                                <thead>
                                    <tr>
                                        <th>User Name</th>
                                        <th>User Email</th>
                                        <th>Role Name</th>
                                        <th>Form Name</th>
                                        <th>User Type</th>
                                        <th>Mobile Number</th>
                                        <th>Is Active</th>
                                        @if (_allowupdate)
                                        {
                                            <th>Edit</th>
                                        }
                                        @if (_allowdelete)
                                        {
                                            <th>Delete</th>
                                        }

                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade  bd-example-modal-lg" id="ModalActiveDirectoryUsers" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Active Directory Users</h5>
                <button type="button" class="btn-gray close closebtn" data-dismiss="modal" aria-label="Close" id="CloseModalBtn">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <div id="ADUserMasterDiv">
                                    <div class="div-loader">
                                        <div class="loader-wrapper d-none">
                                            <span class="loader"></span>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-striped table-bordered" id="TblActiveDirectoryUsers">
                                                <thead>
                                                    <tr>
                                                        <th>User Name</th>
                                                        <th>Login Name</th>
                                                        <th>Email ID</th>
                                                        <th>Designation</th>
                                                        <th>Department</th>
                                                        <th>Select</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section BottomJS {
  <script src="~/Public/js/custom-js/Settings/UserMaster.js"></script>
}

