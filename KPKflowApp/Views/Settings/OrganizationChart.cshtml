@{
    ViewBag.Title = "Workflows";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">Organization Chart</h4>
            </div>
            <div class="card-body">
                <form id="organizationchart" name="organizationchart" method="post" action="">
                    <div class="row">
                        <div class="d-none">
                            <input type="hidden" value="" id="organizationchart" name="id" />
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3">
                            <label>Organization Name</label>
                            <input type="text" class="form-control" id="organizationname" name="organizationname" required>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3">
                            <label>Select Manager</label>
                            <select class="form-select" id="managerid" name="managerid" required>
                                <option value="">Select Manager</option>
                            </select>
                        </div>
                        
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3">
                            <label class="w-100">Select Employee (Single Or Multiple)</label>
                            <select class="form-select" id="employeeid" name="employeeid[]" required multiple>
                                
                            </select>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-2  mt-3 mt-lg-auto">
                            <label>Active</label>
                            <input class="checkboxsize" type="checkbox" id="s-active" name="isactive">
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-4 mt-auto mt-lg-3">
                           @*  @if (_allowinsert)
                            { *@
                            <button class="btn btn-primary btn-sm savebutton me-2 mb-2" type="button" id="SaveBtn"><i class='bx bxs-save pe-2'></i>Save</button>
                            @*}
                            @if (_allowupdate)
                            { *@
                            <button class="btn btn-primary btn-sm updatebutton me-2 mb-2 d-none " type="button" id="UpdateBtn"><i class='bx bxs-save pe-2'></i>Update</button>
                            @* } *@
                        </div>
                        <div class="d-none">
                            <input type="hidden" value="" id="isedit" name="isedit" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div id="organizationchartdiv">
                    <div class="div-loader">
                        <div class="loader-wrapper d-none">
                            <span class="loader"></span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered" id="organizationcharttable">
                                <thead>
                                    <tr>
                                        @* <th>S.No</th> *@
                                        <th>Organization Name</th>
                                        <th>Manager Name</th>
                                        <th>View</th>
                                        <th>Edit</th>
                                        
                                      
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- org chart Modal -->
    <div class="modal fade" id="orgchartmodal" tabindex="-1" aria-labelledby="orgchartlabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="orgchartmodahead">Organization Chart</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="orgchartmodalTable">
                            <thead>
                                <tr>
                                    <th>Employee List</th>
                                
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>



@section BottomJS {
    <script src="~/Public/js/custom-js/Settings/OrganizationChart.js"></script>
}