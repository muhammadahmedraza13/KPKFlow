@inject KPKflowApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Workflows";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section TopCss
{
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link href="~/public/vendor/boxicons/css/boxicons.css" rel="stylesheet" />
    <link href="~/public/vendor/boxicons/css/boxicons.min.css" rel="stylesheet" />
    <link href="~/public/vendor/datatables/css/datatables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/public/css/custom-css/quotation/rfqs.css" rel="stylesheet" />
}

<div class="container-fluid py-4">
    <div class="header-card d-flex justify-content-between align-items-center p-4 shadow-sm mb-4 bg-white rounded-4">
        <div>
            <h4 class="fw-bold mb-1">Bid Portal</h4>
            <p class="text-muted small mb-0">Track and manage your bidding status.</p>
        </div>
        <div id="connection-status" class="d-flex align-items-center gap-2 bg-light px-3 py-2 rounded-pill border">
            <div class="spinner-grow spinner-grow-sm text-success"></div>
            <span class="small fw-bold ">Live Data</span>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-box shadow-sm border-start border-warning border-4">
                <div class="stat-icon bg-warning-subtle text-warning"><i class='bx bx-time'></i></div>
                <div><small class="text-muted fw-bold">PENDING</small><h4 class="mb-0 fw-bold" id="count-pending">0</h4></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-box shadow-sm border-start border-success border-4">
                <div class="stat-icon bg-success-subtle text-success"><i class='bx bx-send'></i></div>
                <div><small class="text-muted fw-bold">SUBMITTED</small><h4 class="mb-0 fw-bold" id="count-submitted">0</h4></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-box shadow-sm border-start border-info border-4">
                <div class="stat-icon bg-info-subtle text-info"><i class='bx bx-trophy'></i></div>
                <div><small class="text-muted fw-bold">SELECTED</small><h4 class="mb-0 fw-bold" id="count-selected">0</h4></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-box shadow-sm border-start border-danger border-4">
                <div class="stat-icon bg-danger-subtle text-danger"><i class='bx bx-x-circle'></i></div>
                <div><small class="text-muted fw-bold">EXPIRED</small><h4 class="mb-0 fw-bold" id="count-expired">0</h4></div>
            </div>
        </div>
    </div>

    <div class="main-card shadow-sm bg-white rounded-4 p-3">
        <table id="rfqDataTable" class="table align-middle w-100">
            <thead class="bg-light">
                <tr>
                    <th>Request ID</th>
                    <th>Bank</th>
                    <th>Ends On</th>
                    <th>Time Remaining</th>
                    <th>Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody id="rfqBody"></tbody>
        </table>
    </div>
</div>

@section BottomJS {
    <script src="~/public/vendor/jquery/jquery-3.7.1.min.js"></script>
    <script src="~/public/vendor/datatables/js/jquery.datatables.js"></script>
    <script src="~/public/vendor/datatables/js/jquery.datatables.min.js"></script>
    <script src="~/public/vendor/datatables/js/datatables.bootstrap5.js"></script>
    <script src="~/public/vendor/datatables/js/datatables.bootstrap5.min.js"></script>
    <script src="~/public/js/custom-js/quotation/rfqs.js"></script>
}